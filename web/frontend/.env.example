# ===== Frontend de Facturación — variables de entorno =====
# Copiá este archivo como .env y completá los valores. El .env NO se commitea.

# Motor de OCR:
#   'gemini'    -> usa el backend (recomendado; OCR + extracción en un paso)
#   'paddleocr' -> usa el backend con el servicio Python PaddleOCR
#   'google'    -> Google Cloud Vision (en el cliente) + parser local (fallback)
#   'ocrspace'  -> OCR.space API (en el cliente) + parser local
#   'tesseract' -> Tesseract.js (en el cliente, sin API key)
VITE_OCR_SERVICE=gemini

# URL del backend en producción (en desarrollo se usa el proxy de Vite).
# VITE_BACKEND_URL=https://tu-backend

# Claves solo necesarias para los motores que corren en el cliente:
# VITE_GOOGLE_VISION_API_KEY=
# VITE_OCR_SPACE_API_KEY=
