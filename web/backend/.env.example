# ===== Backend de Facturación — variables de entorno =====
# Copiá este archivo como .env y completá los valores. El .env NO se commitea.

# --- OCR ---
# Proveedor de OCR: 'gemini' (recomendado) o 'paddleocr' (servicio Python local)
OCR_PROVIDER=gemini

# API key de Gemini (Google AI Studio: https://aistudio.google.com/apikey)
# Necesaria si OCR_PROVIDER=gemini. NUNCA la subas al repo.
GEMINI_API_KEY=

# Modelo de Gemini. El "-lite" es el más económico.
GEMINI_MODEL=gemini-2.5-flash-lite

# URL del servicio Python de PaddleOCR (solo si OCR_PROVIDER=paddleocr)
OCR_SERVICE_URL=http://localhost:5000

# --- Seguridad ---
# Orígenes permitidos por CORS, separados por coma.
# En producción agregá tu dominio, p.ej.: https://tu-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000
